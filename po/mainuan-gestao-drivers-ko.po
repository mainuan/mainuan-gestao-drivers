#. Translators: application name shown in the window title and menus.
#: data/org.mainuan.GestaoDrivers.desktop.in:3
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/__init__.py:25
msgid "Driver Manager"
msgstr "드라이버 매니저"

#: data/org.mainuan.GestaoDrivers.desktop.in:4
msgid "Manage the system's hardware drivers"
msgstr "시스템의 하드웨어 드라이버 관리"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:328
msgid ""
"The prebuilt module's package trust or running-kernel compatibility could "
"not be verified."
msgstr ""
"미리 빌드된 모듈의 패키지 신뢰성 또는 실행 중인 커널과의 호환성을 검증할 수 "
"없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:330
msgid ""
"The prebuilt module's Secure Boot signature trust could not be verified. "
"Repository trust alone does not establish module trust."
msgstr ""
"미리 빌드된 모듈의 Secure Boot 서명 신뢰성을 검증할 수 없습니다. 저장소를 신"
"뢰한다고 해서 모듈을 신뢰할 수 있는 것은 아닙니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:332
msgid ""
"The running kernel is outside the standard prebuilt module update path. "
"Verify module compatibility."
msgstr ""
"실행 중인 커널이 미리 빌드된 모듈의 표준 업데이트 경로를 벗어났습니다. 모듈 "
"호환성을 확인하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:334
msgid ""
"A kernel update is pending. Review system updates before changing drivers."
msgstr ""
"커널 업데이트가 대기 중입니다. 드라이버를 변경하기 전에 시스템 업데이트를 검"
"토하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:336
msgid "The kernel update state could not be verified."
msgstr "커널 업데이트 상태를 검증할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:338
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:670
msgid "Restart the computer and complete key enrollment in MokManager."
msgstr "컴퓨터를 다시 시작하고 MokManager에서 키 등록을 완료하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:342
msgid ""
"PackageKit must resolve the prebuilt/DKMS module alternatives before "
"confirmation."
msgstr ""
"확인하기 전에 PackageKit이 미리 빌드된 모듈/DKMS 모듈 대안을 결정해야 합니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:347
msgid ""
"This driver may need a DKMS module with Secure Boot active or unknown. The "
"actual DKMS signing certificate must be identified and enrolled before "
"changes can be applied."
msgstr ""
"이 드라이버는 Secure Boot가 활성화되어 있거나 상태를 알 수 없을 때 DKMS 모듈"
"이 필요할 수 있습니다. 변경 사항을 적용하려면 먼저 실제 DKMS 서명 인증서를 식"
"별하고 등록해야 합니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:351
msgid ""
"Headers for the running kernel are missing or unverified. Install matching "
"headers through system updates before retrying."
msgstr ""
"실행 중인 커널의 헤더가 없거나 검증되지 않았습니다. 다시 시도하기 전에 시스"
"템 업데이트를 통해 일치하는 헤더를 설치하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:353
msgid "The module build requirements could not be fully verified."
msgstr "모듈 빌드 요구 사항을 완전히 검증할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/session.py:19
msgid ""
"Driver changes are unavailable in the Live Session. Install Mainuan to "
"manage this computer's drivers."
msgstr ""
"라이브 세션에서는 드라이버를 변경할 수 없습니다. 이 컴퓨터의 드라이버를 관리"
"하려면 Mainuan을 설치하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/session.py:21
msgid ""
"The system session could not be verified. Driver changes are blocked; "
"viewing remains available."
msgstr ""
"시스템 세션을 검증할 수 없습니다. 드라이버 변경은 차단되었지만 보기는 계속 사"
"용할 수 있습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:13
msgid "General devices"
msgstr "일반 장치"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:14
msgid "Secure Boot + prebuilt module"
msgstr "Secure Boot + 미리 빌드된 모듈"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:15
msgid "Secure Boot + DKMS + enrolled MOK"
msgstr "Secure Boot + DKMS + 등록된 MOK"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:16
msgid "Secure Boot + DKMS + missing MOK"
msgstr "Secure Boot + DKMS + MOK 없음"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:17
msgid "Secure Boot disabled + DKMS"
msgstr "Secure Boot 비활성화 + DKMS"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:18
msgid "Secure Boot unknown + DKMS"
msgstr "Secure Boot 알 수 없음 + DKMS"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:19
msgid "Broadcom DKMS"
msgstr "Broadcom DKMS"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:20
msgid "NVIDIA custom closed pin"
msgstr "NVIDIA 사용자 지정 독점 드라이버 고정"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:21
msgid "NVIDIA open recommended"
msgstr "NVIDIA 오픈 소스 권장"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:22
msgid "NVIDIA closed recommended"
msgstr "NVIDIA 독점 권장"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:23
msgid "NVIDIA server recommended"
msgstr "NVIDIA 서버용 권장"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:24
msgid "Kernel update pending"
msgstr "커널 업데이트 대기 중"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:25
msgid "Kernel headers missing"
msgstr "커널 헤더 없음"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:26
msgid "MOK enrollment pending"
msgstr "MOK 등록 대기 중"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:27
msgid "Secure Boot + DKMS + unrelated MOK"
msgstr "Secure Boot + DKMS + 관련 없는 MOK"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:28
msgid "Secure Boot + DKMS + matching enrollment pending"
msgstr "Secure Boot + DKMS + 일치하는 등록 대기 중"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:29
msgid "Secure Boot + DKMS + signing unknown"
msgstr "Secure Boot + DKMS + 서명 알 수 없음"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:30
msgid "Installed + driver active"
msgstr "설치됨 + 드라이버 활성"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:31
msgid "Installed + restart required"
msgstr "설치됨 + 다시 시작 필요"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:32
msgid "Installed + MOK enrollment required"
msgstr "설치됨 + MOK 등록 필요"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:33
msgid "Installed + activation unverified"
msgstr "설치됨 + 활성화 확인 안 됨"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:34
msgid "Installed + previous driver bound"
msgstr "설치됨 + 이전 드라이버 연결됨"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:35
msgid "Third-party recommended driver"
msgstr "서드파티 권장 드라이버"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:36
msgid "Third-party DKMS driver"
msgstr "서드파티 DKMS 드라이버"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:37
msgid "Live Session; changes blocked"
msgstr "라이브 세션, 변경 차단됨"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:38
msgid "PackageKit unavailable"
msgstr "PackageKit 사용할 수 없음"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:39
msgid "Driver detection error"
msgstr "드라이버 감지 오류"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/test_scenarios.py:40
msgid "No additional drivers"
msgstr "추가 드라이버 없음"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:214
msgid "Driver detection failed. No new transaction was started."
msgstr "드라이버를 감지하지 못했습니다. 새 트랜잭션을 시작하지 않았습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:240
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:393
msgid "PackageKit is unavailable. Driver detection is still available."
msgstr ""
"PackageKit을 사용할 수 없습니다. 드라이버 감지는 계속 사용할 수 있습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:249
msgid "This PackageKit version is not supported for applying driver changes."
msgstr "이 PackageKit 버전에서는 드라이버 변경 사항 적용을 지원하지 않습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:251
msgid "PackageKit is busy. Wait for the other package operation to finish."
msgstr ""
"PackageKit이 사용 중입니다. 다른 패키지 작업이 끝날 때까지 기다리십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:273
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:433
msgid "The PackageKit service disconnected."
msgstr "PackageKit 서비스 연결이 끊어졌습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:414
msgid "Preparing driver changes..."
msgstr "드라이버 변경 사항 준비 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:531
msgid ""
"PackageKit proposed a package downgrade. This version cannot apply this plan "
"safely."
msgstr ""
"PackageKit이 패키지 다운그레이드를 제안했습니다. 이 버전에서는 이 계획을 안전"
"하게 적용할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:533
msgid ""
"PackageKit reported an untrusted package. No further transaction was started."
msgstr ""
"PackageKit이 신뢰할 수 없는 패키지를 보고했습니다. 추가 트랜잭션을 시작하지 "
"않았습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:539
msgid ""
"PackageKit proposed additional removals outside the confirmed driver plan."
msgstr "PackageKit이 확인된 드라이버 계획 외의 추가 삭제를 제안했습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:541
msgid "A package selected for removal changed version. Review the plan again."
msgstr ""
"삭제하도록 선택한 패키지의 버전이 변경되었습니다. 계획을 다시 검토하십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:547
msgid ""
"A target package changed version or architecture. Review the detected plan "
"again."
msgstr ""
"대상 패키지의 버전 또는 아키텍처가 변경되었습니다. 감지된 계획을 다시 검토하"
"십시오."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:550
msgid ""
"This driver requires a Secure Boot flow that is not supported by this "
"version."
msgstr ""
"이 드라이버에는 이 버전에서 지원하지 않는 Secure Boot 과정이 필요합니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:552
msgid "PackageKit could not safely simulate all planned changes."
msgstr ""
"PackageKit이 계획된 모든 변경 사항을 안전하게 시뮬레이션할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:554
msgid "The removal simulation requires unexpected package installations."
msgstr "삭제 시뮬레이션에 예상하지 못한 패키지 설치가 필요합니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:562
msgid ""
"Installation dependencies changed after removal. No further change was "
"applied."
msgstr ""
"삭제 후 설치 의존성이 변경되었습니다. 추가 변경 사항을 적용하지 않았습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:617
msgid "The package operation was interrupted after changes started."
msgstr "변경이 시작된 후 패키지 작업이 중단되었습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:624
msgid ""
"PackageKit reported an unexpected removal. No further transaction was "
"started."
msgstr ""
"PackageKit이 예상하지 못한 삭제를 보고했습니다. 추가 트랜잭션을 시작하지 않았"
"습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:646
msgid "The operation was cancelled."
msgstr "작업이 취소되었습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:58
msgid "Waiting..."
msgstr "대기 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:59
msgid "Preparing..."
msgstr "준비 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:60
msgid "Resolving dependencies..."
msgstr "의존성 확인 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:61
msgid "Downloading..."
msgstr "다운로드 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:62
msgid "Installing..."
msgstr "설치 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:63
msgid "Removing..."
msgstr "삭제 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:64
msgid "Finalizing..."
msgstr "마무리 중..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:65
msgid "Cancelling..."
msgstr "취소하고 있습니다..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:66
msgid "Finished."
msgstr "완료되었습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:67
msgid "Transaction failed."
msgstr "트랜잭션이 실패했습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:68
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:249
msgid "Transaction cancelled."
msgstr "트랜잭션이 취소되었습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:69
msgid "The driver change was not completed."
msgstr "드라이버 변경을 완료하지 못했습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:87
msgid "The system bus is unavailable."
msgstr "시스템 버스를 사용할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:213
msgid "Driver changes are not enabled in this interface."
msgstr "이 인터페이스에서는 드라이버 변경이 활성화되어 있지 않습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:286
msgid "PackageKit returned an invalid transaction path"
msgstr "PackageKit이 잘못된 트랜잭션 경로를 반환했습니다"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:289
msgid "Cannot subscribe to PackageKit signals"
msgstr "PackageKit 신호를 구독할 수 없습니다"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:322
msgid "Waiting for the PackageKit result. The operation may still be running."
msgstr ""
"PackageKit 결과를 기다리는 중입니다. 작업이 아직 실행 중일 수 있습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:367
msgid "The planned package version is no longer available."
msgstr "계획된 패키지 버전을 더 이상 사용할 수 없습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:370
msgid "A package selected for removal is no longer installed."
msgstr "삭제하도록 선택한 패키지가 더 이상 설치되어 있지 않습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:375
msgid "PackageKit did not complete the transaction."
msgstr "PackageKit이 트랜잭션을 완료하지 않았습니다."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:379
