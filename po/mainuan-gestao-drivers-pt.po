#. Translators: application name shown in the window title and menus.
#: data/org.mainuan.GestaoDrivers.desktop.in:3
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/__init__.py:25
msgid "Driver Manager"
msgstr "Gestor de Controladores"

#: data/org.mainuan.GestaoDrivers.desktop.in:4
msgid "Manage the system's hardware drivers"
msgstr "Gerir os controladores de 'hardware' do sistema"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:328
msgid ""
"The prebuilt module's package trust or running-kernel compatibility could "
"not be verified."
msgstr ""
"Não foi possível verificar a confiança no pacote do módulo pré-compilado nem "
"a compatibilidade com o 'kernel' em execução."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:330
msgid ""
"The prebuilt module's Secure Boot signature trust could not be verified. "
"Repository trust alone does not establish module trust."
msgstr ""
"Não foi possível verificar a confiança na assinatura Secure Boot do módulo "
"pré-compilado. A confiança no repositório, por si só, não garante a "
"confiança no módulo."

# reviewed: ortografia AO90, conforme KDE pt atual (atualizar, ação, ativo,
# deteção, seleção, transação…)
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:332
msgid ""
"The running kernel is outside the standard prebuilt module update path. "
"Verify module compatibility."
msgstr ""
"O 'kernel' em execução está fora do processo-padrão de atualização dos "
"módulos pré-compilados. Verifique a compatibilidade do módulo."

# reviewed: ortografia AO90, conforme KDE pt atual (atualizar, ação, ativo,
# deteção, seleção, transação…)
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:334
msgid ""
"A kernel update is pending. Review system updates before changing drivers."
msgstr ""
"Existe uma atualização do 'kernel' pendente. Reveja as atualizações do "
"sistema antes de alterar os controladores."

# reviewed: ortografia AO90, conforme KDE pt atual (atualizar, ação, ativo,
# deteção, seleção, transação…)
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:336
msgid "The kernel update state could not be verified."
msgstr "Não foi possível verificar o estado de atualização do 'kernel'."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:338
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:670
msgid "Restart the computer and complete key enrollment in MokManager."
msgstr "Reinicie o computador e conclua o registo da chave no MokManager."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:342
msgid ""
"PackageKit must resolve the prebuilt/DKMS module alternatives before "
"confirmation."
msgstr ""
"O PackageKit tem de resolver as alternativas de módulo pré-compilado/DKMS "
"antes da confirmação."

# reviewed: ortografia AO90, conforme KDE pt atual (atualizar, ação, ativo,
# deteção, seleção, transação…)
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:347
msgid ""
"This driver may need a DKMS module with Secure Boot active or unknown. The "
"actual DKMS signing certificate must be identified and enrolled before "
"changes can be applied."
msgstr ""
"Este controlador poderá precisar de um módulo DKMS com o Secure Boot ativo "
"ou desconhecido. O certificado de assinatura DKMS efetivamente usado tem de "
"ser identificado e registado antes de as alterações poderem ser aplicadas."

# reviewed: ortografia AO90, conforme KDE pt atual (atualizar, ação, ativo,
# deteção, seleção, transação…)
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:351
msgid ""
"Headers for the running kernel are missing or unverified. Install matching "
"headers through system updates before retrying."
msgstr ""
"Os cabeçalhos do 'kernel' em execução estão em falta ou não foram "
"verificados. Instale os cabeçalhos correspondentes através das atualizações "
"do sistema antes de tentar de novo."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/preflight.py:353
msgid "The module build requirements could not be fully verified."
msgstr ""
"Não foi possível verificar por completo os requisitos de compilação do "
"módulo."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/session.py:19
msgid ""
"Driver changes are unavailable in the Live Session. Install Mainuan to "
"manage this computer's drivers."
msgstr ""
"As alterações de controladores não estão disponíveis na sessão Live. Instale "
"o Mainuan para gerir os controladores deste computador."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/session.py:21
msgid ""
"The system session could not be verified. Driver changes are blocked; "
"viewing remains available."
msgstr ""
"Não foi possível verificar a sessão do sistema. As alterações de "
"controladores estão bloqueadas; a visualização continua disponível."

