msgstr "PackageKit-tjenesten blev afbrudt."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:414
msgid "Preparing driver changes..."
msgstr "Forbereder driverændringer..."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:531
msgid ""
"PackageKit proposed a package downgrade. This version cannot apply this plan "
"safely."
msgstr ""
"PackageKit foreslog en nedgradering af en pakke. Denne version kan ikke "
"anvende planen sikkert."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:533
msgid ""
"PackageKit reported an untrusted package. No further transaction was started."
msgstr ""
"PackageKit rapporterede en pakke, der ikke er betroet. Der blev ikke startet "
"flere transaktioner."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:539
msgid ""
"PackageKit proposed additional removals outside the confirmed driver plan."
msgstr ""
"PackageKit foreslog yderligere fjernelser uden for den bekræftede driverplan."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:541
msgid "A package selected for removal changed version. Review the plan again."
msgstr ""
"En pakke valgt til fjernelse har skiftet version. Gennemse planen igen."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:547
msgid ""
"A target package changed version or architecture. Review the detected plan "
"again."
msgstr ""
"En målpakke har skiftet version eller arkitektur. Gennemse den registrerede "
"plan igen."

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/execution.py:550
msgid ""
"This driver requires a Secure Boot flow that is not supported by this "
