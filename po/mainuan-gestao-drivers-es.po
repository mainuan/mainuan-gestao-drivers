msgstr "El controlador seleccionado ya no está disponible"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/safety.py:31
msgid ""
"This driver requires a Secure Boot flow that is not supported by this "
"version. No firmware or MOK settings will be changed."
msgstr ""
"Este controlador requiere un procedimiento de Secure Boot que esta versión "
"no admite. No se modificará ninguna configuración del firmware ni de MOK."

