msgstr "План не соответствует обнаруженному состоянию системы"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:170
msgid "Preview or unavailable packages cannot be executed"
msgstr ""
"Пакеты для предварительного просмотра или недоступные пакеты нельзя применить"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:179
