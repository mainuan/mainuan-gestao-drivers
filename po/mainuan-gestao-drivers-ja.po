msgstr "PackageKit が無効なトランザクションパスを返しました"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:289
msgid "Cannot subscribe to PackageKit signals"
msgstr "PackageKit のシグナルを購読できません"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:322
msgid "Waiting for the PackageKit result. The operation may still be running."
msgstr "PackageKit の結果を待っています。操作がまだ実行中の可能性があります。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:367
msgid "The planned package version is no longer available."
msgstr "計画されたパッケージのバージョンはもう利用できません。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:370
msgid "A package selected for removal is no longer installed."
msgstr "削除対象として選択したパッケージはもうインストールされていません。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:375
msgid "PackageKit did not complete the transaction."
msgstr "PackageKit はトランザクションを完了しませんでした。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/packagekit.py:379
msgid "PackageKit destroyed the transaction before Finished"
msgstr "PackageKit が Finished の前にトランザクションを破棄しました"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:160
msgid "A driver transaction plan is required"
msgstr "ドライバのトランザクション計画が必要です"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:164
msgid "Invalid driver selections"
msgstr "無効なドライバの選択"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:167
msgid "Plan does not match the backend snapshot"
msgstr "計画がバックエンドのスナップショットと一致しません"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:170
msgid "Preview or unavailable packages cannot be executed"
msgstr "プレビュー用または利用できないパッケージは実行できません"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:179
msgid "The selected device is no longer available"
msgstr "選択したデバイスはもう利用できません"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/planner.py:184
msgid "The selected driver is no longer available"
msgstr "選択したドライバはもう利用できません"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/backend/transactions/safety.py:31
msgid ""
"This driver requires a Secure Boot flow that is not supported by this "
"version. No firmware or MOK settings will be changed."
msgstr ""
"このドライバには、このバージョンではサポートされていない Secure Boot の手順が"
"必要です。ファームウェアや MOK の設定は変更されません。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/application.py:42
msgid "Show detailed diagnostic logs"
msgstr "詳細な診断ログを表示"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:82
msgid ""
"The driver detection backend is unavailable. Check the application "
"dependencies and try again."
msgstr ""
"ドライバ検出のバックエンドを利用できません。アプリケーションの依存関係を確認"
"して、もう一度お試しください。"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:83
#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:478
msgid "Driver detection failed. Consult the application log for details."
msgstr ""
