#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:654
msgid "Simulation completed. No system changes were made."
msgstr "نقلی عمل مکمل ہو گیا۔ سسٹم میں کوئی تبدیلی نہیں کی گئی۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:655
msgid "The changes were applied successfully."
msgstr "تبدیلیاں کامیابی سے لاگو ہو گئیں۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:656
msgid "No driver changes were necessary."
msgstr "کسی ڈرائیور تبدیلی کی ضرورت نہیں تھی۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:658
msgid "Package changes completed. Driver activation checked separately."
msgstr ""
"پیکیج کی تبدیلیاں مکمل ہو گئیں۔ ڈرائیور کے فعال ہونے کی الگ سے جانچ کی گئی۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:660
msgid ""
"The package download failed. Check the connection and review the detected "
"driver state."
msgstr ""
"پیکیج کا ڈاؤن لوڈ ناکام ہو گیا۔ کنکشن چیک کریں اور ڈرائیور کی شناخت شدہ حالت "
"کا جائزہ لیں۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:662
msgid ""
"Package dependencies prevented this change. No more aggressive removal was "
"attempted."
msgstr ""
"پیکیج کے انحصارات نے اس تبدیلی کو روک دیا۔ مزید جارحانہ ہٹانے کی کوشش نہیں "
"کی گئی۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:664
msgid ""
"The driver operation failed. The actual system state is being detected again."
msgstr ""
"ڈرائیور کارروائی ناکام ہو گئی۔ سسٹم کی اصل حالت دوبارہ معلوم کی جا رہی ہے۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:672
msgid "A system restart is required to complete driver activation."
msgstr "ڈرائیور کو فعال کرنے کی تکمیل کے لیے سسٹم ری اسٹارٹ درکار ہے۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:674
msgid "Restart your session to complete the changes."
msgstr "تبدیلیاں مکمل کرنے کے لیے اپنا سیشن ری اسٹارٹ کریں۔"

#: usr/lib/mainuan/mainuan-gestao-drivers/mainuan_drivers/qt/main_window.py:676
msgid "Restart the affected applications to complete the changes."
msgstr "تبدیلیاں مکمل کرنے کے لیے متاثرہ ایپلی کیشنز ری اسٹارٹ کریں۔"

